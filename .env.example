# 复制为 .env 并填入（也可用环境变量，二选一）
ZHIPU_API_KEY=sk-your-zhipu-key   # gitleaks:allow（占位示例，非真实密钥）
WENSIKU_CODE=WSK-XXXXXX   # gitleaks:allow（占位示例，非真实密钥）
# 模型厂商任选其一（详见 README 表格）
# OPENAI_API_KEY=sk-…
# DEEPSEEK_API_KEY=sk-…
# DASHSCOPE_API_KEY=sk-…
# WENSIKU_PROVIDER=deepseek
# WENSIKU_MODEL=deepseek-chat
